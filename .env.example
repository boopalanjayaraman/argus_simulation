# Argus Simulator environment — copy to .env and fill in. NEVER commit .env.
ARGUS_BASE_URL=http://localhost:8000
ARGUS_INGEST_TOKEN=<server-to-server-token-if-argus-requires-it>
SCENARIOS_DIR=simulated_data
SIM_PORT=4173
IMAGE_INTERVAL_MS=2000
VIDEO_CHUNK_MS=2000
POINTCLOUD_CHUNK_POINTS=50000
RETRY_MAX_ATTEMPTS=3
